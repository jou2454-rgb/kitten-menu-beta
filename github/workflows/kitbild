name: Build Complete Kitten ESP APK

on:
  push:
    branches: [ "main", "master" ]
  workflow_dispatch:

jobs:
  build-apk:
    runs-on: ubuntu-latest

    steps:
    - name: Checkout Source Code
      uses: actions/checkout@v4

    - name: Set up JDK 17
      uses: actions/setup-java@v3
      with:
        distribution: 'zulu'
        java-version: '17'

    - name: Install Android NDK
      uses: android-actions/setup-android@v3
      with:
        ndk-version: '27.3.13750724' # Версия NDK из build.gradle.kts

    - name: Build Native C++ Libraries
      run: |
        cd kitten-esp/app/src/main/jni
        ndk-build NDK_PROJECT_PATH=. APP_BUILD_SCRIPT=Android.mk APPLICATION_MK=Application.mk

    - name: Prepare JniLibs for Gradle
      run: |
        # Создаем структуру папок для нативных библиотек внутри Android-проекта
        mkdir -p kitten-esp/app/src/main/jniLibs/arm64-v8a
        
        # Копируем скомпилированную библиотеку чита
        cp kitten-esp/app/src/main/jni/libs/arm64-v8a/liblemmingrmt.so kitten-esp/app/src/main/jniLibs/arm64-v8a/
        
        # Переименовываем инжектор в формат .so библиотеки, чтобы Gradle автоматически вшил его в APK
        # MainActivity.kt ищет его именно в nativeLibraryDir
        cp kitten-esp/app/src/main/jni/libs/arm64-v8a/injector kitten-esp/app/src/main/jniLibs/arm64-v8a/libinjector.so

    - name: Setup Gradle
      uses: gradle/actions/setup-gradle@v3

    - name: Make Gradle Executable
      run: |
        cd kitten-esp
        chmod +x gradlew

    - name: Build Release APK using Gradle
      run: |
        cd kitten-esp
        ./gradlew assembleRelease

    - name: Upload Finished ESP APK
      uses: actions/upload-artifact@v4
      with:
        name: Kitten-ESP-Release-APK
        path: kitten-esp/app/build/outputs/apk/release/app-release-unsigned.apk
